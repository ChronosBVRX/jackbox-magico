{
  "builds": [
    {
      "src": "api/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/caldero_api.py",
      "use": "@vercel/python"
    },
    {
      "src": "api/copa_final_api.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/caldero/(.*)",
      "dest": "api/caldero_api.py"
    },
    {
      "src": "/api/copa-final/(.*)",
      "dest": "api/copa_final_api.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "api/main.py"
    },
    {
      "src": "/tv/(.*)",
      "dest": "/public/tv/$1"
    },
    {
      "src": "/mobile/(.*)",
      "dest": "/public/mobile/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}