    {"id":"rules.hermione.claridad","event":"rules","character":"Alumna Brillante","voice_key":"hermione","audio_file":"rules_hermione_claridad.mp3","asset_path":"assets/audio/voice_lines/rules_hermione_claridad.mp3","text":"No gana quien grite más fuerte. Gana quien entienda la amenaza y elija antes de que termine el tiempo.","usage":"Reglas alternativas","mood":"didáctico"},

    {"id":"round_start.snape.desprecio","event":"round_start","character":"Profesor de Pociones","voice_key":"snape","audio_file":"round_start_snape_desprecio.mp3","asset_path":"assets/audio/voice_lines/round_start_snape_desprecio.mp3","text":"Comienza otra ronda. Intenten no decepcionarme tan rápido; déjenme al menos terminar la frase.","usage":"Inicio de ronda alternativa","mood":"sarcástico"},
