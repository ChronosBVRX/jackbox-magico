    {"id":"lobby.dobby.sala","event":"lobby","character":"Elfo Caótico","voice_key":"dobby","audio_file":"lobby_dobby_sala.mp3","asset_path":"assets/audio/voice_lines/lobby_dobby_sala.mp3","text":"¡La sala espera! Dobby recomienda entrar antes de que alguien robe tu casa favorita.","usage":"Esperando jugadores","mood":"urgente adorable"},

