  "voice_lines": [
    {"id":"boot.snape.desprecio_inicial","event":"boot","character":"Profesor de Pociones","voice_key":"snape","audio_file":"boot_snape_desprecio_inicial.mp3","asset_path":"assets/audio/voice_lines/boot_snape_desprecio_inicial.mp3","text":"Bien. Otra competencia donde la lógica será opcional y el ruido, inevitable.","usage":"Bienvenida alternativa","mood":"sarcasmo mágico"},
    {"id":"boot.hagrid.emocion","event":"boot","character":"Guardabosques","voice_key":"hagrid","audio_file":"boot_hagrid_emocion.mp3","asset_path":"assets/audio/voice_lines/boot_hagrid_emocion.mp3","text":"¡Eso, muchachos! Entren a la sala y prepárense, que esto se va a poner más intenso que bañar una criatura mágica.","usage":"Bienvenida alternativa","mood":"cálido y divertido"},
    {"id":"boot.ron.nervios","event":"boot","character":"Amigo Nervioso","voice_key":"ron","audio_file":"boot_ron_nervios.mp3","asset_path":"assets/audio/voice_lines/boot_ron_nervios.mp3","text":"¿Todos listos? Yo no. Pero eso nunca ha detenido a nadie aquí.","usage":"Bienvenida alternativa","mood":"nervioso gracioso"},
    {"id":"rules.hermione.instruccion","event":"rules","character":"Alumna Brillante","voice_key":"hermione","audio_file":"boot_hermione_instruccion.mp3","asset_path":"assets/audio/voice_lines/boot_hermione_instruccion.mp3","text":"Antes de empezar, lean las reglas. Sí, ya sé que nadie las lee, por eso las voy a explicar.","usage":"Reclasificada por contexto de frase","mood":"clara y mandona"},
    {"id":"boot.dobby.caos","event":"boot","character":"Elfo Caótico","voice_key":"dobby","audio_file":"boot_dobby_caos.mp3","asset_path":"assets/audio/voice_lines/boot_dobby_caos.mp3","text":"¡Dobby declara que la diversión comienza! Aunque Dobby no se hace responsable por amistades rotas por veinte puntos.","usage":"Bienvenida alternativa","mood":"caótico adorable"},

    {"id":"lobby.ron.no_carga","event":"lobby","character":"Amigo Nervioso","voice_key":"ron","audio_file":"lobby_ron_no_carga.mp3","asset_path":"assets/audio/voice_lines/lobby_ron_no_carga.mp3","text":"Si no te carga, no entres en pánico. Bueno, entra poquito en pánico, pero vuelve a escanear el código.","usage":"Problemas de acceso","mood":"ansioso divertido"},
